  <gazebo>
    <!-- AR4 ros2_control plugin will be configured separately -->
  </gazebo>
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo plugin for ros2_control -->
  <gazebo>
    <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>/home/nikhil/ros2_ws/src/sar_urdf/config/ar4_controller.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- GAZEBO PROPERTIES: Friction for wheels (prevents falling) -->
  <gazebo reference="front_left">
    <mu1>50.0</mu1>
    <mu2>50.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>100.0</maxVel>
  </gazebo>
  
  <gazebo reference="front_right">
    <mu1>50.0</mu1>
    <mu2>50.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>100.0</maxVel>
  </gazebo>
  
  <gazebo reference="back_left">
    <mu1>50.0</mu1>
    <mu2>50.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>100.0</maxVel>
  </gazebo>
  
  <gazebo reference="back_right">
    <mu1>50.0</mu1>
    <mu2>50.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>100.0</maxVel>
  </gazebo>

  <gazebo reference="middle_left">
    <mu1>50.0</mu1>
    <mu2>50.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>100.0</maxVel>
  </gazebo>

  <gazebo reference="middle_right">
    <mu1>50.0</mu1>
    <mu2>50.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>100.0</maxVel>
  </gazebo>


  <!-- Flipper friction -->
  <gazebo reference="f_front_left">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  
  <gazebo reference="f_front_right">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  
  <gazebo reference="f_back_left">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>
  
  <gazebo reference="f_back_right">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <!-- GAZEBO PLUGINS -->
  <gazebo>
    <!-- Differential Drive Controller for 4-wheel skid steering -->
    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>joint_front_left</left_joint>
      <left_joint>joint_middle_left</left_joint>
      <left_joint>joint_back_left</left_joint>
      <right_joint>joint_front_right</right_joint>
      <right_joint>joint_middle_right</right_joint>
      <right_joint>joint_back_right</right_joint>
      <wheel_separation>0.328</wheel_separation>
      <wheel_diameter>0.182</wheel_diameter>
      <max_linear_acceleration>30.0</max_linear_acceleration>
      <max_angular_acceleration>30.0</max_angular_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Joint State Publisher -->
    <plugin filename="libignition-gazebo-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>



    <!-- Flipper Controllers -->
    <plugin filename="libignition-gazebo-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
      <joint_name>joint_f_front_left</joint_name>
      <initial_position>0.0</initial_position>
      <p_gain>500.0</p_gain>
      <i_gain>50.0</i_gain>
      <d_gain>10.0</d_gain>
      <topic>/cmd_f_front_left</topic>
    </plugin>

    <plugin filename="libignition-gazebo-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
      <joint_name>joint_f_front_right</joint_name>
      <initial_position>0.0</initial_position>
      <p_gain>500.0</p_gain>
      <i_gain>50.0</i_gain>
      <d_gain>10.0</d_gain>
      <topic>/cmd_f_front_right</topic>
    </plugin>

    <plugin filename="libignition-gazebo-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
      <joint_name>joint_f_back_left</joint_name>
      <initial_position>0.0</initial_position>
      <p_gain>500.0</p_gain>
      <i_gain>50.0</i_gain>
      <d_gain>10.0</d_gain>
      <topic>/cmd_f_back_left</topic>
    </plugin>

    <plugin filename="libignition-gazebo-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
      <joint_name>joint_f_back_right</joint_name>
      <initial_position>0.0</initial_position>
      <p_gain>500.0</p_gain>
      <i_gain>50.0</i_gain>
      <d_gain>10.0</d_gain>
      <topic>/cmd_f_back_right</topic>
    </plugin>
  </gazebo>

</robot>

