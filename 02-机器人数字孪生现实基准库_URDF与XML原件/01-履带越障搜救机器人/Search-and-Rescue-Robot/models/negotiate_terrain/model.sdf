<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="negotiate_terrain">
    <static>true</static>
    
    <link name="link">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://negotiate_terrain/meshes/negotiate_terrain.stl</uri>
            <scale>1 1 1</scale> 
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100.0</mu> <mu2>50.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://negotiate_terrain/meshes/negotiate_terrain.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
